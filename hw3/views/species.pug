doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(
      content="width=device-width, initial-scale=1.0" 
      name="viewport"
      )
    link(
      href="species.css" 
      rel="stylesheet"
      )
  body
    h1 Species route (Displaying the first 100 characters categorized by species)
    each speciesBucket, i in data
      if data[i].length === 1
        p(class="categoryName") There is #{data[i].length} character in the #{categories[i]} species
      else
        p(class="categoryName") There are #{data[i].length} characters in #{categories[i]} species
      div(class="category")
        each name in speciesBucket
          p(class="name")=name